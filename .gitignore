# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
# …except the example, which holds names and comments and never a value. It is
# the list of what to set in a host's dashboard, so keeping it out of the repo
# would leave that list nowhere.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# typescript build info
tsconfig.tsbuildinfo

# Desktop app (the floating note)
desktop/node_modules
desktop/dist
desktop/src-tauri/target
desktop/src-tauri/gen
