<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Wat de app op macOS mag, als hij ooit ondertekend wordt.

  De hardened runtime zet standaard alles dicht, ook dingen die Chromium
  nodig heeft om te bestaan. Deze vier zijn geen wensen maar wat Electron
  zonder uitzondering vraagt: V8 compileert JavaScript naar machinecode, en
  dat mág niet onder een harde runtime tenzij het hier staat.

  Wat er níét in staat is net zo belangrijk: geen camera, geen microfoon, geen
  toegang tot je bestanden, geen Apple Events. De browser vraagt dat allemaal
  niet, en wat je niet vraagt kan ook niet per ongeluk aanstaan.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
  </dict>
</plist>
