{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tougather note",
  "version": "0.1.2",
  "identifier": "com.tougather.note",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "note",
        "title": "Tougather note",
        "width": 340,
        "height": 480,
        "minWidth": 260,
        "minHeight": 220,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "shadow": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true,
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    },
    "trayIcon": {
      "id": "tougather-note",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["tougather"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "A note that stays on top",
    "longDescription": "Tougather's floating note: a small window that stays above every other app, opens with a keystroke, and keeps what you write in your Tougather account.",
    "copyright": "© Tougather",
    "publisher": "Tougather",
    "createUpdaterArtifacts": false,
    "linux": {
      "deb": {
        "depends": [],
        "desktopTemplate": "tougather-note.desktop"
      },
      "rpm": {
        "desktopTemplate": "tougather-note.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": null,
      "exceptionDomain": null,
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
