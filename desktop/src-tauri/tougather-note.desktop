[Desktop Entry]
Categories={{categories}}
Comment={{comment}}
# %u matters: without it the browser launches this with no URL, and signing in
# through tougather:// silently does nothing. Tauri's default template omits it.
Exec={{exec}} %u
Icon={{icon}}
Name={{name}}
StartupWMClass={{exec}}
Terminal=false
Type=Application
MimeType={{mime_type}}
